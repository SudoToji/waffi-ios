    "error.CAMPAIGN_CHANGED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت هذه الرسالة في مكان آخر. أعد فتحها قبل المحاولة مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message changed somewhere else. Reopen it before trying again."
          }
        }
      }
    },
    "error.CAMPAIGN_NOT_FOUND": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الحملة غير متاحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This campaign is unavailable."
          }
        }
      }
    },
    "error.CAMPAIGN_SCHEDULE_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وقتًا صالحًا بعد دقيقة على الأقل وخلال السنة القادمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid time at least one minute from now and within the next year."
          }
        }
      }
    },
    "error.CAMPAIGN_TEST_RECIPIENT_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بطاقة في هذا النشاط مضافة إلى Apple Wallet أو Google Wallet على هاتف، وافق صاحبها على الرسائل، وتطابق الجمهور المحدد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a card in this business that is in Apple Wallet or Google Wallet on a phone, opted into messages, and matching the selected audience."
          }
        }
      }
    },
    "error.COUPON_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه القسيمة غير متاحة أو منتهية أو سبق استبدالها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This coupon is unavailable, expired, or already redeemed."
          }
        }
      }
    },
    "error.BIRTHDAY_OFFER_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
