    "Allow the camera in Settings to scan Card QR codes. You can still search or type a Manual Code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح باستخدام الكاميرا من الإعدادات لمسح رمز QR على البطاقات. يمكنك أيضًا البحث عن العميل أو كتابة رمز البطاقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the camera in Settings to scan Card QR codes. You can still search or type a Manual Code."
          }
        }
      }
    },
