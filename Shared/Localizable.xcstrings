{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حول التطبيق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحساب"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "Ask the customer to scan this code with their phone camera to follow their order.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من العميل مسح هذا الرمز بكاميرا هاتفه ليتابع طلبه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the customer to scan this code with their phone camera to follow their order."
          }
        }
      }
    },
    "At least 8 characters, with an uppercase letter, a lowercase letter and a number.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "8 أحرف على الأقل، مع حرف كبير (A-Z) وحرف صغير (a-z) ورقم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 8 characters, with an uppercase letter, a lowercase letter and a number."
          }
        }
      }
    },
    "Back to the pad": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العودة إلى لوحة الأرقام"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the pad"
          }
        }
      }
    },
    "Change Branch": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير الفرع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change Branch"
          }
        }
      }
    },
    "Choose the Branch you serve at. You can change it any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الفرع الذي تخدم فيه. يمكنك تغييره في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the Branch you serve at. You can change it any time."
          }
        }
      }
    },
    "Choose your own password": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كلمة مرور خاصة بك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your own password"
