    "Accounts are managed on the Waffi website by the Business Owner. To delete your account, ask your Owner, or open the website and sign in as the Owner.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إدارة الحسابات على موقع وافي بواسطة مالك النشاط التجاري. لحذف حسابك، اطلب ذلك من المالك، أو افتح الموقع وسجّل الدخول بحساب المالك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts are managed on the Waffi website by the Business Owner. To delete your account, ask your Owner, or open the website and sign in as the Owner."
          }
        }
      }
    },
    "Add one stamp": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ختم واحد"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one stamp"
          }
        }
      }
    },
    "Add one stamp to this Customer's Card. Confirm only after a qualifying purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة ختم واحد إلى بطاقة هذا العميل. أكّد فقط بعد عملية شراء مؤهلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one stamp to this Customer's Card. Confirm only after a qualifying purchase."
