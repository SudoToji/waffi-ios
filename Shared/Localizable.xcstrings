        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined at a Branch"
          }
        }
      }
    },
    "%lld days without activity": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld يومًا دون نشاط"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days without activity"
          }
        }
      }
    },
    "Customers with at least one active loyalty card.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء الذين لديهم بطاقة ولاء نشطة واحدة على الأقل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers with at least one active loyalty card."
          }
        }
      }
    },
    "Customers with an active card and no activity in the last %lld days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء ذوو البطاقات النشطة الذين لم يسجلوا نشاطًا خلال آخر %lld يومًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers with an active card and no activity in the last %lld days."
          }
        }
      }
    },
    "Customers at 80% or more of an available reward target, who have not reached it yet. Used one-time rewards and locked membership rewards are excluded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء الذين بلغوا ٨٠٪ أو أكثر من هدف مكافأة متاحة ولم يصلوا إليه بعد. تُستبعد المكافآت المستخدمة لمرة واحدة والمكافآت المقيدة بمستوى عضوية غير متاح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers at 80% or more of an available reward target, who have not reached it yet. Used one-time rewards and locked membership rewards are excluded."
          }
        }
      }
    },
    "Only customers in the selected tiers, including owner overrides.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط العملاء في الشرائح المحددة، بما في ذلك تعيينات المالك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only customers in the selected tiers, including owner overrides."
          }
        }
      }
    },
    "Customers with an active card whose birthday is today (Cairo time). Checked again at the moment of sending, so nothing goes out after midnight.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء ذوو البطاقات النشطة الذين يوافق عيد ميلادهم اليوم (بتوقيت القاهرة). يُعاد التحقق لحظة الإرسال، فلا يُرسل شيء بعد منتصف الليل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers with an active card whose birthday is today (Cairo time). Checked again at the moment of sending, so nothing goes out after midnight."
          }
        }
      }
    },
    "Customers with an active card whose birthday is in the current month (Cairo time). Checked again at the moment of sending.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء ذوو البطاقات النشطة الذين يقع عيد ميلادهم في الشهر الحالي (بتوقيت القاهرة). يُعاد التحقق لحظة الإرسال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers with an active card whose birthday is in the current month (Cairo time). Checked again at the moment of sending."
          }
        }
      }
    },
    "Customers with an active card whose birthday falls on or between the two days you choose, whatever the year. Pick the same day twice for a single day. Checked again at the moment of sending.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء ذوو البطاقات النشطة الذين يقع عيد ميلادهم في اليومين المحددين أو بينهما، أيًّا كانت السنة. اختر اليوم نفسه مرتين ليوم واحد. يُعاد التحقق لحظة الإرسال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers with an active card whose birthday falls on or between the two days you choose, whatever the year. Pick the same day twice for a single day. Checked again at the moment of sending."
          }
        }
      }
    },
    "Only the selected customer card. Marketing consent is still required.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط بطاقة العميل المحدد. موافقة التسويق مطلوبة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected customer card. Marketing consent is still required."
          }
        }
      }
    },
    "Customers who signed up at the chosen Branch. Customers who joined online, or whose Branch is not recorded, are never included. If the Branch closes or is Locked, the campaign reaches nobody until it works again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملاء الذين سجّلوا في الفرع المختار. لا يشمل من انضموا عبر الإنترنت أو من لم يُسجَّل فرعهم. إذا أُغلق الفرع أو قُفل، لا تصل الحملة إلى أحد حتى يعمل الفرع من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers who signed up at the chosen Branch. Customers who joined online, or whose Branch is not recorded, are never included. If the Branch closes or is Locked, the campaign reaches nobody until it works again."
          }
        }
      }
    },
