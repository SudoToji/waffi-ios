    "A one-time in-store offer. Staff redeem it using the customer’s card; no stamps or points are deducted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض يستخدم مرة واحدة داخل المتجر. يستبدله الموظف برقم بطاقة العميل دون خصم أختام أو نقاط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time in-store offer. Staff redeem it using the customer’s card; no stamps or points are deducted."
          }
        }
      }
    },
    "Other offers": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عروض أخرى"
          }
