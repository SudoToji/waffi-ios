    },
    "error.GOOGLE_WALLET_ASSETS_REQUIRED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظة Google ليست جاهزة لهذا البرنامج بعد. يمكنك استخدام بطاقتك هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Wallet is not ready for this program yet. You can still use your card here."
          }
        }
      }
    },
    "error.GOOGLE_WALLET_NOT_CONFIGURED": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظة Google غير متاحة بعد. يمكنك استخدام بطاقتك هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Wallet is not available yet. You can still use your card here."
          }
        }
      }
    },
    "error.GOOGLE_WALLET_CREDENTIALS_INVALID": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظة Google غير متاحة مؤقتًا. يرجى المحاولة لاحقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Wallet is temporarily unavailable. Please try again later."
          }
        }
      }
    },
    "error.GOOGLE_WALLET_UNAVAILABLE": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تجهيز بطاقة محفظة Google. يرجى المحاولة مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not prepare your Google Wallet pass. Please try again."
          }
        }
      }
    }
